# Dedicated customer endpoint, not the existing staff MCP.
PUBLIC_MCP_URL=https://customer-mcp.wooter.com/mcp
WOOTER_ISSUER=https://wooter.com
WOOTER_API_BASE=https://wooter.com/api/
# These two settings refer to a Wooter-provisioned RFC 7662 endpoint and credentials.
# Do not use the ChatGPT OAuth client secret here unless Wooter explicitly provisions it for introspection.
WOOTER_INTROSPECTION_URL=
WOOTER_INTROSPECTION_CLIENT_ID=
WOOTER_INTROSPECTION_CLIENT_SECRET=
# Generate a new 32-byte key: openssl rand -hex 32
REVIEW_KEY_HEX=
DB_PATH=./state/reviews.sqlite
BIND_HOST=127.0.0.1
PORT=8080
# Optional, only if Wooter confirms the exact customer registration page.
WOOTER_SIGNUP_URL=
